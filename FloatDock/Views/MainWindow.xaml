<Window x:Class="FloatDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://schemas.lepo.co/wpf/2022/xaml"
        mc:Ignorable="d"
        Title="FloatDock"
        Icon="pack://application:,,,/Assets/icons8-widget-96.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Windows 11 Fluent Button Style -->
        <Style x:Key="FluentToolButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="FloatDockShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.4"
                          Color="#000000" />
    </Window.Resources>

    <!-- Context Menu for FloatDock Widget -->
    <Window.ContextMenu>
        <ContextMenu Background="#F0202020" Foreground="#FFFFFF" BorderBrush="#33FFFFFF">
            <MenuItem Header="Settings" Click="MenuSettings_Click" />
            <MenuItem Header="Toggle Orientation" Click="MenuOrientation_Click" />
            <Separator Background="#22FFFFFF" />
            <MenuItem Header="Hide Widget" Click="MenuHide_Click" />
            <MenuItem Header="Exit FloatDock" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootContainer" Margin="10">
        <!-- Main Expanded Dock Pill -->
        <Border x:Name="DockPill"
                Background="#D01E1E1E"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{StaticResource FloatDockShadow}"
                Padding="4">

            <!-- Orientation dynamically switches between Horizontal and Vertical -->
            <StackPanel x:Name="ToolsPanel" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Drag Handle -->
                <Border x:Name="DragGrip"
                        Width="18"
                        Height="32"
                        Margin="4,0,2,0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="Drag to reposition or snap to screen edge"
                        MouseLeftButtonDown="DragGrip_MouseLeftButtonDown"
                        MouseLeftButtonUp="DragGrip_MouseLeftButtonUp">
                    <TextBlock Text="⠿"
                               Foreground="#88FFFFFF"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Tool 1: Back Button -->
                <Button x:Name="BtnBack"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="Navigate Back in Active App (Long-press / Right-click for Esc)"
                        Click="BtnBack_Click"
                        MouseRightButtonUp="BtnBack_MouseRightButtonUp"
                        PreviewMouseDown="BtnBack_PreviewMouseDown"
                        PreviewMouseUp="BtnBack_PreviewMouseUp">
                    <Image Source="pack://application:,,,/Assets/icons8-back-100.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Tool 2: Task Manager -->
                <Button x:Name="BtnTaskManager"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="Open or Bring Task Manager to Front"
                        Click="BtnTaskManager_Click">
                    <Image Source="pack://application:,,,/Assets/icons8-chart-96.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Tool 3: Screen Drawing Overlay -->
                <Button x:Name="BtnDrawing"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="Screen Drawing &amp; Annotation Overlay (Ctrl+Alt+D)"
                        Click="BtnDrawing_Click">
                    <Image Source="pack://application:,,,/Assets/icons8-brush-96.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Tool 4: Screenshot Tool -->
                <Button x:Name="BtnScreenshot"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="Capture Screenshot (Ctrl+Alt+S)"
                        Click="BtnScreenshot_Click">
                    <Image Source="pack://application:,,,/Assets/icons8-screenshot-96.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Tool 5: App Switcher -->
                <Button x:Name="BtnAppSwitcher"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="App Switcher &amp; Thumbnail Previews (Ctrl+Alt+Tab)"
                        Click="BtnAppSwitcher_Click">
                    <Image Source="pack://application:,,,/Assets/icons8-apps-40.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Tool 6: Settings Window Button -->
                <Button x:Name="BtnSettings"
                        Style="{StaticResource FluentToolButton}"
                        ToolTip="FloatDock Settings &amp; Configuration"
                        Click="BtnSettings_Click">
                    <Path Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="#B0FFFFFF"
                          Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z" />
                </Button>

                <!-- Collapse / Expand Toggle Button -->
                <Button x:Name="BtnCollapse"
                        Style="{StaticResource FluentToolButton}"
                        Width="24"
                        Height="24"
                        Margin="2,0,2,0"
                        ToolTip="Collapse to floating bubble"
                        Click="BtnCollapse_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#77FFFFFF" />
                </Button>

            </StackPanel>
        </Border>

        <!-- Collapsed Floating Bubble View -->
        <Border x:Name="CollapsedBubble"
                Width="40"
                Height="40"
                Background="#E61E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1.5"
                CornerRadius="20"
                Visibility="Collapsed"
                Cursor="Hand"
                Effect="{StaticResource FloatDockShadow}"
                ToolTip="FloatDock (Left-click to expand, Right-click for Settings)"
                MouseLeftButtonDown="CollapsedBubble_MouseLeftButtonDown"
                MouseRightButtonUp="CollapsedBubble_MouseRightButtonUp">
            <Image Source="pack://application:,,,/Assets/icons8-widget-96.png"
                   Width="24"
                   Height="24"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Border>

    </Grid>
</Window>
