<Window x:Class="FloatDock.Views.ScreenDrawingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FloatDock Screen Drawing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="DrawToolbarBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootCanvasGrid">
        <!-- WPF InkCanvas for smooth high-DPI drawing with pressure support -->
        <InkCanvas x:Name="DrawingCanvas"
                   Background="Transparent"
                   DefaultDrawingAttributesReplaced="DrawingCanvas_DefaultDrawingAttributesReplaced"
                   StrokeCollected="DrawingCanvas_StrokeCollected"
                   PreviewMouseDown="DrawingCanvas_PreviewMouseDown"
                   PreviewMouseUp="DrawingCanvas_PreviewMouseUp"
                   PreviewMouseMove="DrawingCanvas_PreviewMouseMove" />

        <!-- Floating Draggable Drawing Toolbar -->
        <Border x:Name="DrawToolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#F0202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="6,4"
                MouseLeftButtonDown="DrawToolbar_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toolbar Drag Grip -->
                <TextBlock Text="⠿" Foreground="#88FFFFFF" FontSize="14" VerticalAlignment="Center" Margin="4,0,6,0" Cursor="SizeAll" />

                <!-- Mode Selectors: Pen, Highlighter, Eraser -->
                <Button x:Name="BtnPen" Style="{StaticResource DrawToolbarBtn}" ToolTip="Pen (Freehand)" Click="BtnPen_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#4CC2FF" />
                </Button>
                <Button x:Name="BtnHighlighter" Style="{StaticResource DrawToolbarBtn}" ToolTip="Highlighter" Click="BtnHighlighter_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFA70" />
                </Button>
                <Button x:Name="BtnEraser" Style="{StaticResource DrawToolbarBtn}" ToolTip="Eraser (Stroke)" Click="BtnEraser_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" />
                </Button>

                <Separator Width="1" Height="20" Background="#33FFFFFF" Margin="4,0" />

                <!-- Geometric Shapes: Line, Arrow, Rectangle, Ellipse -->
                <Button x:Name="BtnShapeLine" Style="{StaticResource DrawToolbarBtn}" ToolTip="Straight Line" Click="BtnShapeLine_Click">
                    <TextBlock Text="╱" FontSize="14" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnShapeArrow" Style="{StaticResource DrawToolbarBtn}" ToolTip="Arrow" Click="BtnShapeArrow_Click">
                    <TextBlock Text="↗" FontSize="14" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnShapeRect" Style="{StaticResource DrawToolbarBtn}" ToolTip="Rectangle" Click="BtnShapeRect_Click">
                    <TextBlock Text="▭" FontSize="14" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnShapeEllipse" Style="{StaticResource DrawToolbarBtn}" ToolTip="Ellipse / Circle" Click="BtnShapeEllipse_Click">
                    <TextBlock Text="○" FontSize="14" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnText" Style="{StaticResource DrawToolbarBtn}" ToolTip="Add Text Note" Click="BtnText_Click">
                    <TextBlock Text="T" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                </Button>

                <Separator Width="1" Height="20" Background="#33FFFFFF" Margin="4,0" />

                <!-- 8 Color Presets -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                    <Button Width="18" Height="18" Margin="2" Background="#0078D4" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#0078D4" />
                    <Button Width="18" Height="18" Margin="2" Background="#107C10" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#107C10" />
                    <Button Width="18" Height="18" Margin="2" Background="#E81123" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#E81123" />
                    <Button Width="18" Height="18" Margin="2" Background="#FFB900" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#FFB900" />
                    <Button Width="18" Height="18" Margin="2" Background="#B4009E" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#B4009E" />
                    <Button Width="18" Height="18" Margin="2" Background="#00B7C3" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#00B7C3" />
                    <Button Width="18" Height="18" Margin="2" Background="#FFFFFF" BorderThickness="0" CornerRadius="9" Click="ColorPreset_Click" Tag="#FFFFFF" />
                    <Button Width="18" Height="18" Margin="2" Background="#000000" BorderThickness="1" BorderBrush="#88FFFFFF" CornerRadius="9" Click="ColorPreset_Click" Tag="#000000" />
                </StackPanel>

                <!-- Thickness Slider -->
                <Slider x:Name="SliderThickness"
                        Width="60"
                        Minimum="1"
                        Maximum="24"
                        Value="3.5"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        ToolTip="Stroke Thickness"
                        ValueChanged="SliderThickness_ValueChanged" />

                <Separator Width="1" Height="20" Background="#33FFFFFF" Margin="4,0" />

                <!-- Undo / Redo / Clear -->
                <Button x:Name="BtnUndo" Style="{StaticResource DrawToolbarBtn}" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnRedo" Style="{StaticResource DrawToolbarBtn}" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" />
                </Button>
                <Button x:Name="BtnClear" Style="{StaticResource DrawToolbarBtn}" ToolTip="Clear All Drawings" Click="BtnClear_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF6B6B" />
                </Button>

                <Separator Width="1" Height="20" Background="#33FFFFFF" Margin="4,0" />

                <!-- Pass-through mode (Click-through to underlying apps) -->
                <Button x:Name="BtnPassThrough" Style="{StaticResource DrawToolbarBtn}" ToolTip="Pass-Through Mode (Click desktop underneath)" Click="BtnPassThrough_Click">
                    <TextBlock x:Name="TxtPassThrough" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#AAAAAA" />
                </Button>

                <!-- Save Screenshot of Drawings -->
                <Button x:Name="BtnSaveDrawings" Style="{StaticResource DrawToolbarBtn}" ToolTip="Save Screenshot with Annotations" Click="BtnSaveDrawings_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#4CC2FF" />
                </Button>

                <!-- Exit Drawing Mode -->
                <Button x:Name="BtnClose" Style="{StaticResource DrawToolbarBtn}" ToolTip="Close Drawing Overlay (Esc)" Click="BtnClose_Click">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF9999" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Pass-through HUD notification when active -->
        <Border x:Name="PassThroughBanner"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Background="#D0101010"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6">
            <TextBlock Text="⚡ Pass-Through Active: You can click underlying apps. Click FloatDock icon or press Ctrl+Alt+D to re-enable drawing."
                       Foreground="#FFFF88"
                       FontSize="13" />
        </Border>
    </Grid>
</Window>
