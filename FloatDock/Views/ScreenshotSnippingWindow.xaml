<Window x:Class="FloatDock.Views.ScreenshotSnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FloatDock Snipping Tool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <Grid x:Name="OverlayGrid">
        <!-- Captured Desktop Background Image Freeze -->
        <Image x:Name="BackgroundScreenshot" Stretch="Fill" />

        <!-- Dimmed Semi-Transparent Dark Mask -->
        <Canvas x:Name="DimmedMask" Background="#66000000" />

        <!-- Rubber-Band Selection Rectangle (Cutout) -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#4CC2FF"
                BorderThickness="1.5"
                Background="#01000000"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

        <!-- Dimension HUD Tooltip (e.g., 640 x 480 px) -->
        <Border x:Name="DimensionHud"
                Visibility="Collapsed"
                Background="#EE1A1A1A"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <TextBlock x:Name="TxtDimensionHud"
                       Text="0 x 0 px"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontFamily="Segoe UI Semibold" />
        </Border>

        <!-- Top Mode Selector Bar -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#F0202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="6,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnModeRegion" Content="Region" Margin="4,2" Padding="8,4" Background="#33FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Click="BtnModeRegion_Click" />
                <Button x:Name="BtnModeWindow" Content="Window" Margin="4,2" Padding="8,4" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="BtnModeWindow_Click" />
                <Button x:Name="BtnModeMonitor" Content="Current Monitor" Margin="4,2" Padding="8,4" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="BtnModeMonitor_Click" />
                <Button x:Name="BtnModeVirtual" Content="All Monitors" Margin="4,2" Padding="8,4" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="BtnModeVirtual_Click" />

                <Separator Width="1" Height="16" Background="#33FFFFFF" Margin="6,0" />

                <TextBlock Text="Press Esc to cancel" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
